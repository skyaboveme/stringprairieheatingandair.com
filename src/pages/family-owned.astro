---
import Layout from "../layouts/Layout.astro";

const breadcrumbs = [
    { name: "Home", url: "https://stringprairieheatingandair.com/" },
    {
        name: "Family-Owned",
        url: "https://stringprairieheatingandair.com/family-owned",
    },
];
---

<Layout
    title="Family-Owned HVAC Company | String Prairie Heating & Air"
    description="String Prairie Heating & Air is a family-owned and operated business in Bastrop County. We provide personal, trustworthy service you can rely on."
    breadcrumbs={breadcrumbs}
>
    <section class="page-header">
        <div class="container">
            <h1>Family-Owned & Operated</h1>
            <p>Personal service from our family to yours</p>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <div class="grid-layout">
                <div class="text-content">
                    <h2>The String Prairie Difference</h2>
                    <p>
                        In a world of corporate consolidations and private
                        equity buyouts, String Prairie Heating & Air remains
                        proudly family-owned and independent. Founded by Ron M.
                        Hammons and his father, we've built our business on the
                        simple principles of honesty, hard work, and treating
                        people right.
                    </p>

                    <h3>Why It Matters</h3>
                    <p>
                        When you hire a family-owned business, you're not just a
                        number in a database. You're a neighbor. We live here,
                        our kids go to school here, and we see our customers at
                        the grocery store and church.
                    </p>

                    <div class="benefits-list">
                        <div class="benefit-item">
                            <span class="benefit-icon">🤝</span>
                            <div class="benefit-text">
                                <h4>Personal Acountability</h4>
                                <p>
                                    Our name is on the truck. We take personal
                                    pride in every job we do and stand behind
                                    our work 100%.
                                </p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">🛡️</span>
                            <div class="benefit-text">
                                <h4>Trust & Integrity</h4>
                                <p>
                                    We believe in fixing what's broken, not
                                    selling you what you don't need. Our
                                    reputation is built on honest assessments.
                                </p>
                            </div>
                        </div>
                        <div class="benefit-item">
                            <span class="benefit-icon">👨‍👩‍👧‍👦</span>
                            <div class="benefit-text">
                                <h4>Generational Knowledge</h4>
                                <p>
                                    With HVAC experience passed down through
                                    generations, we combine old-school
                                    craftsmanship with modern technical
                                    training.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="image-content">
                    <img
                        src="/34761b_3f7f333425354739b252151655d852f0~mv2.avif"
                        alt="Hammons Family"
                        class="rounded-image"
                    />
                    <div class="caption">
                        The Hammons Family - Proudly Serving Bastrop County
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Join Our Family of Customers</h2>
            <p>
                Experience the difference of working with a local, family-owned
                business.
            </p>
            <div class="cta-buttons">
                <a
                    href="https://book.housecallpro.com/book/String-Prairie-Heating--Air/df82ded280ce43f4a9ee6ee6d36aef76?v2=true"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-light">🔖 Book Online</a
                >
                <a href="tel:5129249744" class="btn btn-outline"
                    >Call (512) 924-9744</a
                >
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background: linear-gradient(
            135deg,
            var(--dark-blue) 0%,
            var(--primary-blue) 100%
        );
        color: white;
        padding: 5rem 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .page-header h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .page-header p {
        font-size: 1.35rem;
        opacity: 0.95;
        font-weight: 300;
    }

    .content-section {
        padding: 5rem 0;
        background: white;
    }

    .grid-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    .text-content h2 {
        color: var(--dark-blue);
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .text-content h3 {
        color: var(--primary-blue);
        font-size: 1.75rem;
        margin: 2rem 0 1rem;
        font-weight: 700;
    }

    .text-content p {
        color: var(--text-dark);
        font-size: 1.1rem;
        line-height: 1.8;
        font-weight: 300;
        margin-bottom: 1.5rem;
    }

    .benefits-list {
        margin-top: 2rem;
    }

    .benefit-item {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 2rem;
        background: var(--bg-light);
        padding: 1.5rem;
        border-radius: 12px;
        transition: transform 0.3s;
    }

    .benefit-item:hover {
        transform: translateX(5px);
        background: #f0fdf4; /* Light green tint */
    }

    .benefit-icon {
        font-size: 2.5rem;
    }

    .benefit-text h4 {
        color: var(--dark-blue);
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
    }

    .benefit-text p {
        margin-bottom: 0;
        font-size: 1rem;
    }

    .image-content {
        position: relative;
    }

    .rounded-image {
        width: 100%;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        border-bottom: 5px solid var(--accent-red);
    }

    .caption {
        text-align: center;
        margin-top: 1rem;
        color: var(--text-light);
        font-style: italic;
    }

    .cta-section {
        background: linear-gradient(
            135deg,
            var(--accent-red) 0%,
            var(--dark-red) 100%
        );
        color: white;
        padding: 5rem 0;
        text-align: center;
    }

    .cta-section h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .cta-section p {
        font-size: 1.35rem;
        margin-bottom: 2.5rem;
        font-weight: 300;
    }

    .cta-buttons {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 1.25rem 2.5rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.3s;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-light {
        background: white;
        color: var(--primary-blue);
    }

    .btn-light:hover {
        background: rgba(255, 255, 255, 0.95);
        transform: translateY(-3px);
    }

    .btn-outline {
        background: transparent;
        color: white;
        border: 2px solid white;
    }

    .btn-outline:hover {
        background: white;
        color: var(--accent-red);
        transform: translateY(-3px);
    }

    @media (max-width: 900px) {
        .grid-layout {
            grid-template-columns: 1fr;
        }
        .image-content {
            order: -1;
            margin-bottom: 2rem;
        }
    }

    @media (max-width: 768px) {
        .page-header h1 {
            font-size: 2rem;
        }
    }
</style>
