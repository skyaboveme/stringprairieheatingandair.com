---
import Layout from "../layouts/Layout.astro";

const breadcrumbs = [
    { name: "Home", url: "https://stringprairieheatingandair.com/" },
    {
        name: "Specials",
        url: "https://stringprairieheatingandair.com/specials",
    },
];

const specials = [
    {
        title: "Spring AC Tune-Up Special",
        description:
            "Get your air conditioning system ready for summer with our comprehensive spring tune-up. Includes filter replacement, coil cleaning, refrigerant check, electrical inspection, and full system performance test.",
        price: "$89",
        regularPrice: "$125",
        validThrough: "2026-05-31",
        icon: "🌸",
    },
    {
        title: "New System Installation Discount",
        description:
            "Upgrade to a new, energy-efficient HVAC system and save. Includes professional installation, load calculation, permit handling, and manufacturer warranty registration.",
        price: "$500 Off",
        regularPrice: "",
        validThrough: "2026-12-31",
        icon: "❄️",
    },
    {
        title: "Referral Bonus",
        description:
            "Know a neighbor who needs HVAC work? Refer a friend or family member to String Prairie Heating & Air and you'll both receive a discount on your next service.",
        price: "$50 Off Each",
        regularPrice: "",
        validThrough: "2026-12-31",
        icon: "🤝",
    },
    {
        title: "Military & Senior Discount",
        description:
            "We proudly offer a discount on all services for active military, veterans, and seniors (65+). Thank you for your service to our community.",
        price: "10% Off",
        regularPrice: "",
        validThrough: "2026-12-31",
        icon: "🇺🇸",
    },
    {
        title: "Fall Heating Tune-Up",
        description:
            "Prepare your furnace or heat pump for winter with our thorough fall maintenance. Includes safety inspection, carbon monoxide check, ignition test, and full system evaluation.",
        price: "$89",
        regularPrice: "$125",
        validThrough: "2026-11-30",
        icon: "🍂",
    },
    {
        title: "First-Time Customer Discount",
        description:
            "New to String Prairie Heating & Air? Welcome to the family! Enjoy a discount on your first service call, whether it's a repair, maintenance, or consultation.",
        price: "$25 Off",
        regularPrice: "",
        validThrough: "2026-12-31",
        icon: "👋",
    },
];

const offerSchema = {
    "@context": "https://schema.org",
    "@type": "HVACBusiness",
    name: "String Prairie Heating & Air",
    url: "https://stringprairieheatingandair.com",
    telephone: "(512) 924-9744",
    hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Current Specials & Promotions",
        itemListElement: specials.map((s) => ({
            "@type": "Offer",
            name: s.title,
            description: s.description,
            price: s.price,
            priceCurrency: "USD",
            availability: "https://schema.org/InStock",
            validThrough: s.validThrough,
            offeredBy: {
                "@type": "HVACBusiness",
                name: "String Prairie Heating & Air",
            },
        })),
    },
};
---

<Layout
    title="HVAC Specials & Coupons in Bastrop, TX | String Prairie Heating & Air"
    description="Save on HVAC services in Bastrop County. Current specials, coupons, and seasonal offers on AC repair, heating tune-ups, and new system installation from String Prairie Heating & Air."
    breadcrumbs={breadcrumbs}
>
    <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(offerSchema)}
    />

    <section class="page-header">
        <div class="container">
            <h1>Specials & Promotions</h1>
            <p>
                Save on quality HVAC service from your trusted Bastrop County
                experts
            </p>
        </div>
    </section>

    <section class="specials-content">
        <div class="container">
            <div class="specials-intro">
                <p class="lead">
                    At String Prairie Heating & Air, quality HVAC service
                    doesn't have to break the bank. Take advantage of our
                    current specials and promotions to save on repairs,
                    maintenance, and new system installations throughout Bastrop
                    County.
                </p>
            </div>

            <div class="specials-grid">
                {
                    specials.map((special) => (
                        <div class="special-card">
                            <div class="special-icon">{special.icon}</div>
                            <h3>{special.title}</h3>
                            <div class="special-pricing">
                                <span class="special-price">
                                    {special.price}
                                </span>
                                {special.regularPrice && (
                                    <span class="regular-price">
                                        Reg. {special.regularPrice}
                                    </span>
                                )}
                            </div>
                            <p class="special-description">
                                {special.description}
                            </p>
                            <p class="special-valid">
                                Valid through{" "}
                                {new Date(
                                    special.validThrough,
                                ).toLocaleDateString("en-US", {
                                    year: "numeric",
                                    month: "long",
                                    day: "numeric",
                                })}
                            </p>
                            <a
                                href="https://book.housecallpro.com/book/String-Prairie-Heating--Air/df82ded280ce43f4a9ee6ee6d36aef76?v2=true"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="special-btn"
                            >
                                Claim This Offer
                            </a>
                        </div>
                    ))
                }
            </div>

            <div class="specials-note">
                <h3>How to Redeem</h3>
                <p>
                    Simply mention the special when you book your appointment
                    online or call us at
                    <a href="tel:5129249744">(512) 924-9744</a>. Offers cannot
                    be combined with other promotions unless specified. Valid
                    for Bastrop County and surrounding areas.
                </p>
            </div>

            <div class="cta-section">
                <h2>Ready to Save?</h2>
                <p>
                    Book your service today and take advantage of these
                    limited-time offers.
                </p>
                <div class="cta-buttons">
                    <a
                        href="https://book.housecallpro.com/book/String-Prairie-Heating--Air/df82ded280ce43f4a9ee6ee6d36aef76?v2=true"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary">🔖 Book Online</a
                    >
                    <a href="tel:5129249744" class="btn btn-secondary"
                        >Call (512) 924-9744</a
                    >
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    .page-header {
        background: linear-gradient(
            135deg,
            var(--dark-blue) 0%,
            var(--primary-blue) 100%
        );
        color: white;
        padding: 5rem 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(
            circle at 70% 50%,
            rgba(34, 197, 94, 0.15) 0%,
            transparent 50%
        );
        pointer-events: none;
    }

    .page-header h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        position: relative;
        z-index: 1;
    }

    .page-header p {
        font-size: 1.35rem;
        opacity: 0.95;
        font-weight: 300;
        position: relative;
        z-index: 1;
    }

    .specials-content {
        padding: 5rem 0;
        background: white;
    }

    .specials-intro {
        text-align: center;
        max-width: 800px;
        margin: 0 auto 4rem;
    }

    .lead {
        font-size: 1.2rem;
        color: var(--text-dark);
        line-height: 1.8;
        font-weight: 300;
    }

    .specials-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 2rem;
        margin-bottom: 4rem;
    }

    .special-card {
        background: var(--bg-light);
        padding: 2.5rem;
        border-radius: 12px;
        border-top: 5px solid var(--accent-red);
        text-align: center;
        transition: all 0.3s;
        display: flex;
        flex-direction: column;
    }

    .special-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(41, 94, 147, 0.12);
        border-top-color: var(--primary-blue);
    }

    .special-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .special-card h3 {
        color: var(--dark-blue);
        font-size: 1.3rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
    }

    .special-pricing {
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .special-price {
        font-size: 2rem;
        font-weight: 800;
        color: var(--accent-red);
    }

    .regular-price {
        font-size: 1rem;
        color: var(--text-light);
        text-decoration: line-through;
        font-weight: 300;
    }

    .special-description {
        color: var(--text-dark);
        line-height: 1.7;
        font-weight: 300;
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
        flex: 1;
    }

    .special-valid {
        color: var(--text-light);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1.5rem;
    }

    .special-btn {
        display: inline-block;
        padding: 0.9rem 2rem;
        background: radial-gradient(
            circle,
            var(--accent-red) 0%,
            var(--dark-red) 100%
        );
        color: white;
        text-decoration: none;
        border-radius: 50px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
        transition: all 0.3s;
    }

    .special-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .specials-note {
        background: var(--bg-light);
        padding: 2.5rem;
        border-radius: 12px;
        border-left: 5px solid var(--primary-blue);
        margin-bottom: 4rem;
    }

    .specials-note h3 {
        color: var(--dark-blue);
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .specials-note p {
        color: var(--text-dark);
        line-height: 1.8;
        font-weight: 300;
    }

    .specials-note a {
        color: var(--primary-blue);
        text-decoration: none;
        font-weight: 600;
    }

    .specials-note a:hover {
        text-decoration: underline;
    }

    .cta-section {
        text-align: center;
        background: linear-gradient(
            135deg,
            var(--accent-red) 0%,
            var(--dark-red) 100%
        );
        color: white;
        padding: 4rem 3rem;
        border-radius: 12px;
    }

    .cta-section h2 {
        font-size: 2.25rem;
        margin-bottom: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .cta-section p {
        font-size: 1.2rem;
        margin-bottom: 2rem;
        opacity: 0.95;
        font-weight: 300;
    }

    .cta-buttons {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 1.25rem 2.5rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.3s;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 1rem;
    }

    .btn-primary {
        background: white;
        color: var(--accent-red);
        box-shadow: 0 4px 12px rgba(255, 255, 255, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(255, 255, 255, 0.4);
    }

    .btn-secondary {
        background: transparent;
        color: white;
        border: 2px solid white;
    }

    .btn-secondary:hover {
        background: white;
        color: var(--accent-red);
        transform: translateY(-3px);
    }

    @media (max-width: 768px) {
        .page-header h1 {
            font-size: 2rem;
        }

        .specials-grid {
            grid-template-columns: 1fr;
        }

        .cta-section h2 {
            font-size: 1.75rem;
        }

        .cta-buttons {
            flex-direction: column;
        }
    }
</style>
