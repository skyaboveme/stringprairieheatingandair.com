---
import Layout from "../../layouts/Layout.astro";

const breadcrumbs = [
	{ name: "Home", url: "https://stringprairieheatingandair.com/" },
	{ name: "Services", url: "https://stringprairieheatingandair.com/services" },
	{
		name: "Furnace Installation",
		url: "https://stringprairieheatingandair.com/services/furnace-installation",
	},
];

const serviceSchema = {
	"@context": "https://schema.org",
	"@type": "Service",
	serviceType: "Furnace Installation and Replacement",
	name: "Furnace Installation in Bastrop County, TX",
	description:
		"Safe, code-compliant gas, propane, and electric furnace installation and replacement in Bastrop, Rosanky, Smithville, Elgin, and surrounding Central Texas communities.",
	provider: {
		"@type": "HVACBusiness",
		"@id": "https://stringprairieheatingandair.com/#business",
		name: "String Prairie Heating & Air",
		telephone: "+1-512-924-9744",
		url: "https://stringprairieheatingandair.com",
	},
	url: "https://stringprairieheatingandair.com/services/furnace-installation",
};
---

<Layout
	title="Furnace Installation & Replacement in Bastrop, TX | String Prairie"
	description="Need a new gas, propane, or electric furnace in Bastrop County? String Prairie Heating & Air delivers expert sizing, clean installs, and financing. Call (512) 924-9744."
	breadcrumbs={breadcrumbs}
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

	<section class="page-header">
		<div class="container">
			<h1>Furnace Installation & Replacement</h1>
			<p>Safe, reliable winter heating for Bastrop County homes and rural properties</p>
		</div>
	</section>

	<section class="service-content">
		<div class="container">
			<div class="service-intro">
				<h2>Gas, Propane & Electric Furnace Replacement Done Right</h2>
				<p class="lead">
					Whether your older furnace has a cracked heat exchanger, struggles during Texas cold snaps, or you're replacing your complete heating and cooling system, String Prairie Heating & Air provides honest guidance and meticulous installations. We service both city natural gas homes and rural propane or all-electric properties across Bastrop County.
				</p>
			</div>

			<div class="service-grid">
				<div class="service-main">
					<h3>Systems We Install</h3>
					<ul class="service-list">
						<li>
							<strong>Natural Gas & Propane Furnaces</strong>
							<p>High-AFUE single-stage, two-stage, and variable-speed furnaces with full flue venting, gas pressure testing, and carbon monoxide safety checks.</p>
						</li>
						<li>
							<strong>Electric Air Handlers & Heat Strips</strong>
							<p>Clean, reliable electric heating paired with high-efficiency cooling or heat pumps for homes without gas lines.</p>
						</li>
						<li>
							<strong>Complete Matched HVAC Systems</strong>
							<p>Save on labor and maximize equipment longevity by upgrading your furnace and AC condenser together with full manufacturer warranty registration.</p>
						</li>
					</ul>

					<h3>Signs It's Time to Replace Your Furnace</h3>
					<ul class="plain-list">
						<li>Your furnace is 15+ years old and needing frequent repairs</li>
						<li>Cracked heat exchanger, yellow burner flame, or soot buildup</li>
						<li>Uneven heating across rooms or rising winter gas/electric bills</li>
						<li>Loud banging, booming on startup, or rattling blower noises</li>
					</ul>

					<h3>Related Services & Guides</h3>
					<div class="related-links">
						<a href="/services/heating-repair">Heating & Furnace Repair</a>
						<a href="/services/heat-pump-services">Heat Pump & Dual-Fuel Systems</a>
						<a href="/financing">Flexible Financing</a>
						<a href="/warranties">Equipment Warranties</a>
						<a href="/blog/when-to-replace-your-hvac-system">When to Replace Your HVAC System</a>
					</div>
				</div>

				<aside class="service-sidebar">
					<div class="cta-box">
						<h3>Get a Free Furnace Quote</h3>
						<p>Upfront, written estimates with good, better, and best options—zero high-pressure tactics.</p>
						<a
							href="https://book.housecallpro.com/book/String-Prairie-Heating--Air/df82ded280ce43f4a9ee6ee6d36aef76?v2=true"
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary">🔖 Request Free Estimate</a
						>
						<a href="tel:5129249744" class="btn btn-secondary">Call (512) 924-9744</a>
					</div>

					<div class="info-box">
						<h4>Every Install Includes</h4>
						<ul>
							<li>Proper Manual J heating & cooling load sizing</li>
							<li>Safe removal & disposal of old equipment</li>
							<li>Gas/electrical & carbon monoxide safety check</li>
							<li>Manufacturer warranty registration</li>
							<li>Full homeowner walkthrough</li>
						</ul>
					</div>
				</aside>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		background-image:
			linear-gradient(rgba(10, 30, 60, 0.8), rgba(10, 30, 60, 0.9)),
			url("/Images/heating-repair-header-bg.webp");
		background-size: cover;
		background-position: center;
		color: white;
		padding: 7rem 0;
		text-align: center;
	}
	.page-header h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.page-header p {
		font-size: 1.3rem;
		opacity: 0.95;
	}
	.service-content {
		padding: 5rem 0;
		background: white;
	}
	.service-intro {
		max-width: 900px;
		margin: 0 auto 4rem;
		text-align: center;
	}
	.service-intro h2 {
		color: var(--dark-blue);
		font-size: 2.3rem;
		margin-bottom: 1.25rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.lead {
		font-size: 1.15rem;
		line-height: 1.8;
	}
	.service-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 3rem;
	}
	.service-main h3 {
		color: var(--primary-blue);
		font-size: 1.6rem;
		margin: 2rem 0 1.25rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.service-main h3:first-child {
		margin-top: 0;
	}
	.service-list {
		list-style: none;
		padding: 0;
	}
	.service-list li {
		background: var(--bg-light);
		padding: 1.5rem;
		margin-bottom: 1rem;
		border-radius: 10px;
		border-left: 4px solid var(--accent-red);
	}
	.service-list strong {
		display: block;
		color: var(--dark-blue);
		font-size: 1.15rem;
		margin-bottom: 0.4rem;
	}
	.plain-list {
		padding-left: 1.5rem;
		line-height: 1.9;
	}
	.related-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.related-links a {
		background: #eff6ff;
		color: var(--primary-blue);
		padding: 0.6rem 1.1rem;
		border-radius: 50px;
		text-decoration: none;
		font-weight: 600;
	}
	.related-links a:hover {
		background: var(--primary-blue);
		color: white;
	}
	.cta-box {
		background: linear-gradient(135deg, var(--dark-blue), var(--primary-blue));
		color: white;
		padding: 2.25rem;
		border-radius: 12px;
		text-align: center;
		margin-bottom: 2rem;
	}
	.cta-box h3 {
		font-size: 1.5rem;
		margin-bottom: 0.75rem;
		text-transform: uppercase;
	}
	.cta-box p {
		margin-bottom: 1.5rem;
	}
	.btn {
		display: block;
		width: 100%;
		padding: 1rem 1.5rem;
		border-radius: 50px;
		text-decoration: none;
		font-weight: 700;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}
	.btn-primary {
		background: linear-gradient(135deg, var(--accent-red), var(--dark-red));
		color: white;
	}
	.btn-secondary {
		background: white;
		color: var(--primary-blue);
	}
	.info-box {
		background: var(--bg-light);
		padding: 1.75rem;
		border-radius: 12px;
		border-left: 4px solid var(--primary-blue);
	}
	.info-box h4 {
		color: var(--dark-blue);
		margin-bottom: 1rem;
		text-transform: uppercase;
	}
	.info-box ul {
		list-style: none;
		padding: 0;
	}
	.info-box li {
		padding: 0.4rem 0;
	}
	@media (max-width: 900px) {
		.service-grid {
			grid-template-columns: 1fr;
		}
		.page-header h1 {
			font-size: 2.1rem;
		}
	}
</style>
